# Copy to deploy/.env.production on VPS, then edit secrets.

# Public server
PUBLIC_HOST=foru.web.id
API_PORT=3000
WEB_PORT=80
HTTPS_PORT=443

# Frontend build-time API URL.
# If using Nginx reverse proxy from same host, keep this:
VITE_API_URL=/api
# If exposing API directly, use:
# VITE_API_URL=http://103.253.244.190:3000/api

# PostgreSQL
POSTGRES_DB=foru_pos
POSTGRES_USER=foru
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://foru:CHANGE_ME_STRONG_PASSWORD@postgres:5432/foru_pos?schema=public

# API
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
NODE_ENV=production
APP_URL=https://foru.web.id
FRONTEND_URL=https://foru.web.id
CORS_ORIGINS=https://foru.web.id,https://localhost,capacitor://localhost,ionic://localhost
