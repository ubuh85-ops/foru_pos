generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  username     String        @unique
  passwordHash String        @map("password_hash")
  pinHash      String?       @map("pin_hash")
  role         Role
  status       Status        @default(ACTIVE)
  lastLogin    DateTime?     @map("last_login")
  inventoryPermissions String[] @default([]) @map("inventory_permissions")
  assignedWarehouseId String?       @map("assigned_warehouse_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  sessions     CashSession[]
  closedSessions CashSession[] @relation("CashSessionClosedBy")
  auditLogs    AuditLog[]
  couponUsages CouponUsage[]
  expenses     Expense[]
  printerLogs  PrinterLog[]
  sales        Sale[]
  outlets      UserOutlet[]
  inventoryMovements InventoryMovement[]
  createdStockTransfers StockTransfer[] @relation("StockTransferCreatedBy")
  completedStockTransfers StockTransfer[] @relation("StockTransferCompletedBy")
  assignedWarehouse InventoryWarehouse? @relation(fields: [assignedWarehouseId], references: [id], onDelete: SetNull)
  memberships BusinessMembership[]

  @@map("users")
}

model Business {
  id        String         @id @default(cuid())
  code      String         @unique
  name      String
  legalName String?        @map("legal_name")
  logoUrl   String?        @map("logo_url")
  phone     String?
  email     String?
  address   String?
  status    BusinessStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  memberships BusinessMembership[]
  outlets     Outlet[]
  products    Product[]
  categories  Category[]
  variantGroups VariantGroup[]
  sales       Sale[]
  cashSessions CashSession[]
  printers    Printer[]
  printerLogs PrinterLog[]
  auditLogs   AuditLog[]
  expenses    Expense[]
  expenseCategories ExpenseCategory[]
  inventoryCategories InventoryCategory[]
  inventoryUnits InventoryUnit[]
  inventoryItems InventoryItem[]
  inventoryWarehouses InventoryWarehouse[]
  inventoryMovements InventoryMovement[]
  stockTransfers StockTransfer[]
  coupons Coupon[]

  @@map("businesses")
}

model BusinessMembership {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  userId     String   @map("user_id")
  role       Role
  status     Status   @default(ACTIVE)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId])
  @@map("business_memberships")
}

model Outlet {
  id             String                @id @default(cuid())
  businessId     String                @map("business_id")
  code           String
  name           String
  address        String?
  phone          String?
  inventoryWarehouseId String?         @map("inventory_warehouse_id")
  blockSaleWhenIngredientOutOfStock Boolean @default(true) @map("block_sale_when_ingredient_out_of_stock")
  allowSaleWithoutRecipe Boolean       @default(true) @map("allow_sale_without_recipe")
  autoPrintReceipt Boolean             @default(false) @map("auto_print_receipt")
  autoPrintKitchen Boolean             @default(false) @map("auto_print_kitchen")
  autoPrintCustomerItemList Boolean    @default(false) @map("auto_print_customer_item_list")
  customerOrderingEnabled Boolean      @default(false) @map("customer_ordering_enabled")
  customerOrderingSlug String?         @map("customer_ordering_slug")
  acceptingCustomerOrders Boolean      @default(true) @map("accepting_customer_orders")
  customerOrderAllowDineIn Boolean     @default(true) @map("customer_order_allow_dine_in")
  customerOrderAllowTakeAway Boolean   @default(true) @map("customer_order_allow_take_away")
  customerOrderAllowDelivery Boolean   @default(false) @map("customer_order_allow_delivery")
  customerOrderRequestPhone Boolean    @default(false) @map("customer_order_request_phone")
  customerOrderSoundEnabled Boolean    @default(false) @map("customer_order_sound_enabled")
  preOrderEnabled Boolean              @default(true) @map("pre_order_enabled")
  preOrderMinLeadMinutes Int           @default(60) @map("pre_order_min_lead_minutes")
  preOrderMaxDaysAhead Int             @default(14) @map("pre_order_max_days_ahead")
  preOrderSlotMinutes Int              @default(30) @map("pre_order_slot_minutes")
  customerOrderOpenTime String         @default("08:00") @map("customer_order_open_time")
  customerOrderCloseTime String        @default("21:00") @map("customer_order_close_time")
  customerOrderOperatingDays Int[]     @default([0, 1, 2, 3, 4, 5, 6]) @map("customer_order_operating_days")
  timezone String                      @default("Asia/Jakarta")
  status         Status                @default(ACTIVE)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  sessions       CashSession[]
  couponOutlets  CouponOutlet[]
  couponUsages   CouponUsage[]
  expenses        Expense[]
  products       ProductOutlet[]
  productChannelPrices ProductChannelPrice[]
  printers       Printer[]
  printerLogs    PrinterLog[]
  sales          Sale[]
  saleItems      SaleItem[]
  users          UserOutlet[]
  variantOptions VariantOptionOutlet[]
  warehouses      InventoryWarehouse[]
  defaultInventoryWarehouse InventoryWarehouse? @relation("OutletDefaultInventoryWarehouse", fields: [inventoryWarehouseId], references: [id], onDelete: SetNull)
  business       Business              @relation(fields: [businessId], references: [id])

  @@unique([businessId, code])
  @@unique([businessId, customerOrderingSlug])
  @@index([businessId])
  @@map("outlets")
}

model UserOutlet {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  outletId  String   @map("outlet_id")
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, outletId])
  @@map("user_outlets")
}

model Product {
  id             String                @id @default(cuid())
  businessId     String                @map("business_id")
  sku            String?
  name           String
  category       String
  categoryId     String?               @map("category_id")
  basePrice      Decimal               @default(0) @map("base_price") @db.Decimal(14, 2)
  baseHpp        Decimal               @default(0) @map("base_hpp") @db.Decimal(14, 2)
  description    String?
  imageUrl       String?               @map("image_url")
  status         Status                @default(ACTIVE)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  categoryRef    Category?             @relation(fields: [categoryId], references: [id])
  couponProducts CouponProduct[]
  addons         ProductAddon[]
  outlets        ProductOutlet[]
  channelPrices  ProductChannelPrice[]
  variantGroups  ProductVariantGroup[]
  variants       ProductVariant[]
  saleItems      SaleItem[]
  recipes        ProductRecipe[]
  inventoryMovements InventoryMovement[]
  business       Business              @relation(fields: [businessId], references: [id])

  @@unique([businessId, sku])
  @@index([businessId])
  @@map("products")
}

model Category {
  id          String    @id @default(cuid())
  businessId  String    @map("business_id")
  name        String
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]
  business    Business  @relation(fields: [businessId], references: [id])

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, sortOrder])
  @@map("categories")
}

model VariantGroup {
  id          String                @id @default(cuid())
  businessId  String                @map("business_id")
  name        String
  description String?
  minSelect   Int                   @default(0) @map("min_select")
  maxSelect   Int                   @default(1) @map("max_select")
  required    Boolean               @default(false)
  status      Status                @default(ACTIVE)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  options     VariantOption[]
  products    ProductVariantGroup[]
  business    Business              @relation(fields: [businessId], references: [id])

  @@unique([businessId, name])
  @@index([businessId])
  @@map("variant_groups")
}

model VariantOption {
  id              String                @id @default(cuid())
  variantGroupId  String                @map("variant_group_id")
  name            String
  additionalPrice Decimal               @default(0) @map("additional_price") @db.Decimal(14, 2)
  hpp             Decimal               @default(0) @db.Decimal(14, 2)
  sortOrder       Int                   @default(0) @map("sort_order")
  status          Status                @default(ACTIVE)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  group           VariantGroup          @relation(fields: [variantGroupId], references: [id], onDelete: Cascade)
  outlets         VariantOptionOutlet[]

  @@map("variant_options")
}

model VariantOptionOutlet {
  id              String        @id @default(cuid())
  variantOptionId String        @map("variant_option_id")
  outletId        String        @map("outlet_id")
  additionalPrice Decimal?      @map("additional_price") @db.Decimal(14, 2)
  hpp             Decimal?      @db.Decimal(14, 2)
  status          Status        @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  option          VariantOption @relation(fields: [variantOptionId], references: [id], onDelete: Cascade)
  outlet          Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([variantOptionId, outletId])
  @@map("variant_option_outlets")
}

model ProductVariantGroup {
  id             String       @id @default(cuid())
  productId      String       @map("product_id")
  variantGroupId String       @map("variant_group_id")
  sortOrder      Int          @default(0) @map("sort_order")
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  group          VariantGroup @relation(fields: [variantGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, variantGroupId])
  @@map("product_variant_groups")
}

model ProductVariant {
  id           String       @id @default(cuid())
  productId    String       @map("product_id")
  variantName  String       @map("variant_name")
  sellingPrice Decimal      @map("selling_price") @db.Decimal(14, 2)
  hpp          Decimal      @db.Decimal(14, 2)
  status       Status       @default(ACTIVE)
  bundleItems  BundleItem[]
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems    SaleItem[]

  @@map("product_variants")
}

model ProductAddon {
  id             String          @id @default(cuid())
  productId      String          @map("product_id")
  addonName      String          @map("addon_name")
  price          Decimal         @db.Decimal(14, 2)
  hpp            Decimal         @db.Decimal(14, 2)
  status         Status          @default(ACTIVE)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItemAddons SaleItemAddon[]

  @@map("product_addons")
}

model ProductOutlet {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  outletId    String   @map("outlet_id")
  isActive    Boolean  @default(true) @map("is_active")
  isAvailable Boolean  @default(true) @map("is_available")
  outletPrice Decimal? @map("outlet_price") @db.Decimal(14, 2)
  outletHpp   Decimal? @map("outlet_hpp") @db.Decimal(14, 2)
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, outletId])
  @@map("product_outlets")
}

model ProductChannelPrice {
  id              String         @id @default(cuid())
  productId       String         @map("product_id")
  outletId        String         @map("outlet_id")
  channel         PaymentMethod
  price           Decimal        @db.Decimal(14, 2)
  status          Status         @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  outlet          Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([productId, outletId, channel])
  @@index([outletId, channel])
  @@map("product_channel_prices")
}

model ProductRecipe {
  id              String        @id @default(cuid())
  productId       String        @map("product_id")
  inventoryItemId String        @map("inventory_item_id")
  usageQty        Decimal       @map("usage_qty") @db.Decimal(14, 3)
  usageUnitId     String        @map("usage_unit_id")
  wastePercent    Decimal       @default(0) @map("waste_percent") @db.Decimal(5, 2)
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  item            InventoryItem @relation(fields: [inventoryItemId], references: [id])
  usageUnit       InventoryUnit @relation(fields: [usageUnitId], references: [id])

  @@unique([productId, inventoryItemId])
  @@index([inventoryItemId])
  @@index([usageUnitId])
  @@map("product_recipes")
}

model Bundle {
  id           String       @id @default(cuid())
  bundleName   String       @map("bundle_name")
  sellingPrice Decimal      @map("selling_price") @db.Decimal(14, 2)
  hpp          Decimal      @db.Decimal(14, 2)
  status       Status       @default(ACTIVE)
  items        BundleItem[]

  @@map("bundles")
}

model BundleItem {
  id               String         @id @default(cuid())
  bundleId         String         @map("bundle_id")
  productVariantId String         @map("product_variant_id")
  qty              Int
  bundle           Bundle         @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])

  @@map("bundle_items")
}

model CashSession {
  id                String        @id @default(cuid())
  businessId         String        @map("business_id")
  outletId          String        @map("outlet_id")
  cashierId         String        @map("cashier_id")
  closedByUserId    String?       @map("closed_by_user_id")
  openingCash       Decimal       @map("opening_cash") @db.Decimal(14, 2)
  closingCashActual Decimal?      @map("closing_cash_actual") @db.Decimal(14, 2)
  expectedCash      Decimal?      @map("expected_cash") @db.Decimal(14, 2)
  variance          Decimal?      @db.Decimal(14, 2)
  openedAt          DateTime      @default(now()) @map("opened_at")
  closedAt          DateTime?     @map("closed_at")
  status            SessionStatus @default(OPEN)
  cashier           User          @relation(fields: [cashierId], references: [id])
  closedBy          User?         @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id])
  outlet            Outlet        @relation(fields: [outletId], references: [id])
  expenses          Expense[]
  sales             Sale[]
  printerLogs       PrinterLog[]
  business          Business      @relation(fields: [businessId], references: [id])

  @@index([businessId, outletId, openedAt])
  @@map("cash_sessions")
}

model Sale {
  id                        String        @id @default(cuid())
  businessId                String        @map("business_id")
  orderNumber               String?       @unique @map("order_number")
  transactionNumber         String?       @unique @map("transaction_number")
  outletId                  String        @map("outlet_id")
  cashierId                 String?       @map("cashier_id")
  cashSessionId             String?       @map("cash_session_id")
  customerName              String        @default("Walk In") @map("customer_name")
  customerPhone             String?       @map("customer_phone")
  tableNumber               String?       @map("table_number")
  orderNote                 String?       @map("order_note")
  orderType                 String        @default("DINE_IN") @map("order_type")
  orderSource               String        @default("POS") @map("order_source")
  customerOrderRequestId    String?       @unique @map("customer_order_request_id")
  publicOrderToken          String?       @unique @map("public_order_token")
  isPreOrder                Boolean       @default(false) @map("is_pre_order")
  scheduledAt               DateTime?     @map("scheduled_at")
  subtotal                  Decimal       @db.Decimal(14, 2)
  discountAmount            Decimal       @default(0) @map("discount_amount") @db.Decimal(14, 2)
  totalAmount               Decimal       @map("total_amount") @db.Decimal(14, 2)
  subtotalBeforeDiscount    Decimal       @map("subtotal_before_discount") @db.Decimal(14, 2)
  productDiscountTotal      Decimal       @default(0) @map("product_discount_total") @db.Decimal(14, 2)
  transactionDiscountAmount Decimal       @default(0) @map("transaction_discount_amount") @db.Decimal(14, 2)
  couponCode                String?       @map("coupon_code")
  couponDiscountAmount      Decimal       @default(0) @map("coupon_discount_amount") @db.Decimal(14, 2)
  grandTotal                Decimal       @map("grand_total") @db.Decimal(14, 2)
  totalHpp                  Decimal       @map("total_hpp") @db.Decimal(14, 2)
  grossProfit               Decimal       @map("gross_profit") @db.Decimal(14, 2)
  paymentMethod             PaymentMethod? @map("payment_method")
  cashReceived              Decimal?      @map("cash_received") @db.Decimal(14, 2)
  changeAmount              Decimal?      @map("change_amount") @db.Decimal(14, 2)
  status                    SaleStatus    @default(PAID)
  voidReason                String?       @map("void_reason")
  savedAt                   DateTime      @default(now()) @map("saved_at")
  submittedAt               DateTime?     @map("submitted_at")
  acceptedAt                DateTime?     @map("accepted_at")
  acceptedByUserId          String?       @map("accepted_by_user_id")
  rejectedAt                DateTime?     @map("rejected_at")
  rejectedByUserId          String?       @map("rejected_by_user_id")
  rejectionReason           String?       @map("rejection_reason")
  paidAt                    DateTime?     @map("paid_at")
  cancelledAt               DateTime?     @map("cancelled_at")
  voidedAt                  DateTime?     @map("voided_at")
  cancelReason              String?       @map("cancel_reason")
  createdAt                 DateTime      @default(now()) @map("created_at")
  couponUsage               CouponUsage?
  items                     SaleItem[]
  printerLogs               PrinterLog[]
  cashSession               CashSession?  @relation(fields: [cashSessionId], references: [id])
  cashier                   User?         @relation(fields: [cashierId], references: [id])
  outlet                    Outlet        @relation(fields: [outletId], references: [id])
  business                  Business      @relation(fields: [businessId], references: [id])

  @@index([businessId, outletId, createdAt])
  @@index([businessId, outletId, status, orderSource, createdAt])
  @@index([businessId, outletId, status, scheduledAt])
  @@index([outletId, createdAt])
  @@map("sales")
}

model Printer {
  id                String         @id @default(cuid())
  businessId         String         @map("business_id")
  outletId          String         @map("outlet_id")
  printerName       String         @map("printer_name")
  printerType       PrinterType    @default(THERMAL) @map("printer_type")
  connectionType    ConnectionType @map("connection_type")
  paperSize         PaperSize      @default(MM58) @map("paper_size")
  ipAddress         String?        @map("ip_address")
  port              Int?
  bluetoothAddress  String?        @map("bluetooth_address")
  usbVendorId       String?        @map("usb_vendor_id")
  usbProductId      String?        @map("usb_product_id")
  isCustomerReceipt Boolean        @default(false) @map("is_customer_receipt")
  isKitchenPrinter  Boolean        @default(false) @map("is_kitchen_printer")
  status            Status         @default(ACTIVE)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  outlet            Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  logs              PrinterLog[]
  business          Business       @relation(fields: [businessId], references: [id])

  @@index([businessId, outletId])
  @@map("printers")
}

model PrinterLog {
  id           String      @id @default(cuid())
  businessId   String      @map("business_id")
  outletId     String      @map("outlet_id")
  saleId       String?     @map("sale_id")
  cashSessionId String?    @map("cash_session_id")
  printerId    String?     @map("printer_id")
  printType    PrintType   @map("print_type")
  status       PrintStatus
  errorMessage String?     @map("error_message")
  printedBy    String      @map("printed_by")
  printedAt    DateTime    @default(now()) @map("printed_at")
  outlet       Outlet      @relation(fields: [outletId], references: [id])
  printer      Printer?    @relation(fields: [printerId], references: [id])
  sale         Sale?       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  cashSession  CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [printedBy], references: [id])
  business     Business    @relation(fields: [businessId], references: [id])

  @@index([businessId, printedAt])
  @@index([saleId, printType])
  @@index([cashSessionId, printType])
  @@map("printer_logs")
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  changedBy  String   @map("changed_by")
  changedAt  DateTime @default(now()) @map("changed_at")
  user       User     @relation(fields: [changedBy], references: [id])
  business   Business @relation(fields: [businessId], references: [id])

  @@index([businessId, changedAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model IdempotencyKey {
  id         String   @id @default(cuid())
  key        String   @unique
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  payloadHash String?  @map("payload_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("idempotency_keys")
}

model SaleItem {
  id                    String          @id @default(cuid())
  saleId                String          @map("sale_id")
  outletId              String          @map("outlet_id")
  productId             String          @map("product_id")
  productVariantId      String?         @map("product_variant_id")
  productName           String          @map("product_name")
  variantName           String          @map("variant_name")
  itemNote              String?         @map("item_note") @db.VarChar(255)
  qty                   Int
  sellingPrice          Decimal         @map("selling_price") @db.Decimal(14, 2)
  hpp                   Decimal         @db.Decimal(14, 2)
  subtotal              Decimal         @db.Decimal(14, 2)
  totalHpp              Decimal         @map("total_hpp") @db.Decimal(14, 2)
  grossProfit           Decimal         @map("gross_profit") @db.Decimal(14, 2)
  priceBeforeDiscount   Decimal         @map("price_before_discount") @db.Decimal(14, 2)
  discountType          DiscountType?
  discountValue         Decimal?        @map("discount_value") @db.Decimal(14, 2)
  discountAmount        Decimal         @default(0) @map("discount_amount") @db.Decimal(14, 2)
  subtotalAfterDiscount Decimal         @map("subtotal_after_discount") @db.Decimal(14, 2)
  selectedVariantsJson  Json?           @map("selected_variants_json")
  basePrice             Decimal         @default(0) @map("base_price") @db.Decimal(14, 2)
  outletPrice           Decimal?        @map("outlet_price") @db.Decimal(14, 2)
  channel               PaymentMethod?  @map("channel")
  dineInPriceSnapshot   Decimal?        @map("dine_in_price_snapshot") @db.Decimal(14, 2)
  channelPriceSnapshot  Decimal?        @map("channel_price_snapshot") @db.Decimal(14, 2)
  priceSource           String?         @map("price_source")
  baseMarginPercent     Decimal?        @map("base_margin_percent_snapshot") @db.Decimal(8, 2)
  actualMarginPercent   Decimal?        @map("actual_margin_percent") @db.Decimal(8, 2)
  variantPriceTotal     Decimal         @default(0) @map("variant_price_total") @db.Decimal(14, 2)
  finalUnitPrice        Decimal         @default(0) @map("final_unit_price") @db.Decimal(14, 2)
  baseHpp               Decimal         @default(0) @map("base_hpp") @db.Decimal(14, 2)
  outletHpp             Decimal?        @map("outlet_hpp") @db.Decimal(14, 2)
  variantHppTotal       Decimal         @default(0) @map("variant_hpp_total") @db.Decimal(14, 2)
  finalUnitHpp          Decimal         @default(0) @map("final_unit_hpp") @db.Decimal(14, 2)
  addons                SaleItemAddon[]
  inventoryMovements    InventoryMovement[]
  outlet                Outlet          @relation(fields: [outletId], references: [id])
  product               Product         @relation(fields: [productId], references: [id])
  variant               ProductVariant? @relation(fields: [productVariantId], references: [id])
  sale                  Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_items")
}

model SaleItemAddon {
  id         String       @id @default(cuid())
  saleItemId String       @map("sale_item_id")
  addonId    String       @map("addon_id")
  addonName  String       @map("addon_name")
  price      Decimal      @db.Decimal(14, 2)
  hpp        Decimal      @db.Decimal(14, 2)
  addon      ProductAddon @relation(fields: [addonId], references: [id])
  saleItem   SaleItem     @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  @@map("sale_item_addons")
}

model Expense {
  id              String           @id @default(cuid())
  businessId      String?          @map("business_id")
  outletId        String           @map("outlet_id")
  cashSessionId   String           @map("cash_session_id")
  cashierId       String           @map("cashier_id")
  categoryId      String?          @map("category_id")
  categoryName    String           @map("category_name")
  description     String
  amount          Decimal          @db.Decimal(14, 2)
  paymentSource   PaymentSource    @default(CASH_DRAWER) @map("payment_source")
  note            String?
  receiptImageUrl String?          @map("receipt_image_url")
  status          ExpenseStatus    @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  cashSession     CashSession      @relation(fields: [cashSessionId], references: [id])
  categoryRef     ExpenseCategory? @relation(fields: [categoryId], references: [id])
  cashier         User             @relation(fields: [cashierId], references: [id])
  business        Business?        @relation(fields: [businessId], references: [id])
  outlet          Outlet           @relation(fields: [outletId], references: [id])

  @@index([businessId, outletId])
  @@map("expenses")
}

model ExpenseCategory {
  id          String    @id @default(cuid())
  businessId  String    @map("business_id")
  name        String
  description String?
  status      Status    @default(ACTIVE)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  expenses    Expense[]
  business    Business  @relation(fields: [businessId], references: [id])

  @@unique([businessId, name])
  @@index([businessId])
  @@map("expense_categories")
}

model InventoryCategory {
  id          String          @id @default(cuid())
  businessId  String          @map("business_id")
  name        String
  status      Status          @default(ACTIVE)
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  items       InventoryItem[]
  business    Business        @relation(fields: [businessId], references: [id])

  @@unique([businessId, name])
  @@index([businessId])
  @@map("inventory_categories")
}

model InventoryUnit {
  id        String          @id @default(cuid())
  businessId String         @map("business_id")
  name      String
  status    Status          @default(ACTIVE)
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  items     InventoryItem[]
  productRecipes ProductRecipe[]
  fromUnitConversions InventoryUnitConversion[] @relation("InventoryUnitConversionFrom")
  toUnitConversions   InventoryUnitConversion[] @relation("InventoryUnitConversionTo")
  business  Business        @relation(fields: [businessId], references: [id])

  @@unique([businessId, name])
  @@index([businessId])
  @@map("inventory_units")
}

model InventoryItem {
  id           String              @id @default(cuid())
  businessId   String              @map("business_id")
  code         String
  sku          String?
  barcode      String?
  name         String
  categoryId   String              @map("category_id")
  unitId       String              @map("unit_id")
  minimumStock Decimal             @default(0) @map("minimum_stock") @db.Decimal(14, 3)
  currentStock Decimal             @default(0) @map("current_stock") @db.Decimal(14, 3)
  averageCost  Decimal             @default(0) @map("average_cost") @db.Decimal(14, 2)
  supplier     String?
  notes        String?
  photoUrl     String?             @map("photo_url")
  stockAlertEnabled Boolean        @default(false) @map("stock_alert_enabled")
  stockAlertType InventoryStockAlertType @default(LOW_STOCK) @map("stock_alert_type")
  stockAlertThreshold Decimal?     @map("stock_alert_threshold") @db.Decimal(14, 3)
  lastStockAlertAt DateTime?       @map("last_stock_alert_at")
  stockAlertState InventoryStockAlertState @default(NORMAL) @map("stock_alert_state")
  status       Status              @default(ACTIVE)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  category     InventoryCategory   @relation(fields: [categoryId], references: [id])
  unit         InventoryUnit       @relation(fields: [unitId], references: [id])
  movements    InventoryMovement[]
  alertLogs    InventoryAlertLog[]
  stocks       InventoryStock[]
  transferItems StockTransferItem[]
  productRecipes ProductRecipe[]
  unitConversions InventoryUnitConversion[]
  business     Business            @relation(fields: [businessId], references: [id])

  @@unique([businessId, code])
  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([name])
  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
  @@map("inventory_items")
}

model InventoryUnitConversion {
  id              String        @id @default(cuid())
  inventoryItemId String        @map("inventory_item_id")
  fromUnitId      String        @map("from_unit_id")
  toUnitId        String        @map("to_unit_id")
  multiplier      Decimal       @db.Decimal(18, 6)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  item            InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  fromUnit        InventoryUnit @relation("InventoryUnitConversionFrom", fields: [fromUnitId], references: [id])
  toUnit          InventoryUnit @relation("InventoryUnitConversionTo", fields: [toUnitId], references: [id])

  @@unique([inventoryItemId, fromUnitId, toUnitId])
  @@index([fromUnitId])
  @@index([toUnitId])
  @@map("inventory_unit_conversions")
}

model InventoryWarehouse {
  id          String              @id @default(cuid())
  businessId  String              @map("business_id")
  code        String
  name        String
  type        InventoryWarehouseType @default(CENTRAL)
  outletId    String?             @map("outlet_id")
  address     String?
  picName     String?             @map("pic_name")
  phone       String?
  status      Status              @default(ACTIVE)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  outlet      Outlet?             @relation(fields: [outletId], references: [id], onDelete: SetNull)
  defaultForOutlets Outlet[]       @relation("OutletDefaultInventoryWarehouse")
  stocks      InventoryStock[]
  movements   InventoryMovement[]
  transferFrom StockTransfer[]    @relation("StockTransferFromWarehouse")
  transferTo   StockTransfer[]    @relation("StockTransferToWarehouse")
  assignedUsers User[]
  business    Business            @relation(fields: [businessId], references: [id])

  @@unique([businessId, code])
  @@index([businessId])
  @@map("inventory_warehouses")
}

model InventoryStock {
  id              String             @id @default(cuid())
  warehouseId     String             @map("warehouse_id")
  inventoryItemId String             @map("inventory_item_id")
  currentQty      Decimal            @default(0) @map("current_qty") @db.Decimal(14, 3)
  reservedQty     Decimal            @default(0) @map("reserved_qty") @db.Decimal(14, 3)
  availableQty    Decimal            @default(0) @map("available_qty") @db.Decimal(14, 3)
  averageCost     Decimal            @default(0) @map("average_cost") @db.Decimal(14, 2)
  lastMovementAt  DateTime?          @map("last_movement_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  warehouse       InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  item            InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, inventoryItemId])
  @@index([inventoryItemId])
  @@map("inventory_stocks")
}

model InventoryAlertLog {
  id              String                     @id @default(cuid())
  inventoryItemId String                     @map("inventory_item_id")
  alertType       InventoryStockAlertType    @map("alert_type")
  currentStock    Decimal                    @map("current_stock") @db.Decimal(14, 3)
  threshold       Decimal?                   @db.Decimal(14, 3)
  title           String
  message         String
  status          InventoryAlertLogStatus    @default(SENT)
  sentAt          DateTime                   @default(now()) @map("sent_at")
  errorMessage    String?                    @map("error_message")
  item            InventoryItem              @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId, sentAt])
  @@index([status, sentAt])
  @@map("inventory_alert_logs")
}

model InventoryMovement {
  id              String                @id @default(cuid())
  businessId       String                @map("business_id")
  movementNumber  String?               @unique @map("movement_number")
  warehouseId     String?               @map("warehouse_id")
  inventoryItemId String                @map("inventory_item_id")
  movementType    InventoryMovementType @map("movement_type")
  qty             Decimal               @db.Decimal(14, 3)
  beforeQty       Decimal               @map("before_qty") @db.Decimal(14, 3)
  afterQty        Decimal               @map("after_qty") @db.Decimal(14, 3)
  unitCost        Decimal?              @map("unit_cost") @db.Decimal(14, 2)
  totalCost       Decimal?              @map("total_cost") @db.Decimal(14, 2)
  referenceType   String?               @map("reference_type")
  reference       String?
  referenceId     String?               @map("reference_id")
  productId       String?               @map("product_id")
  orderItemId     String?               @map("order_item_id")
  remarks         String?
  createdBy       String                @map("created_by")
  createdAt       DateTime              @default(now()) @map("created_at")
  item            InventoryItem         @relation(fields: [inventoryItemId], references: [id])
  warehouse       InventoryWarehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  product         Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderItem       SaleItem?             @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  user            User                  @relation(fields: [createdBy], references: [id])
  business        Business              @relation(fields: [businessId], references: [id])

  @@index([businessId, createdAt])
  @@index([inventoryItemId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([productId, createdAt])
  @@index([orderItemId, createdAt])
  @@index([movementType, createdAt])
  @@map("inventory_movements")
}

model StockTransfer {
  id              String              @id @default(cuid())
  businessId       String              @map("business_id")
  transferNumber  String              @unique @map("transfer_number")
  fromWarehouseId String              @map("from_warehouse_id")
  toWarehouseId   String              @map("to_warehouse_id")
  status          StockTransferStatus @default(DRAFT)
  notes           String?
  createdBy       String              @map("created_by")
  completedBy     String?             @map("completed_by")
  createdAt       DateTime            @default(now()) @map("created_at")
  completedAt     DateTime?           @map("completed_at")
  fromWarehouse   InventoryWarehouse  @relation("StockTransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse     InventoryWarehouse  @relation("StockTransferToWarehouse", fields: [toWarehouseId], references: [id])
  creator         User                @relation("StockTransferCreatedBy", fields: [createdBy], references: [id])
  completer       User?               @relation("StockTransferCompletedBy", fields: [completedBy], references: [id], onDelete: SetNull)
  items           StockTransferItem[]
  business        Business            @relation(fields: [businessId], references: [id])

  @@index([businessId, createdAt])
  @@index([fromWarehouseId, createdAt])
  @@index([toWarehouseId, createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id              String        @id @default(cuid())
  stockTransferId String        @map("stock_transfer_id")
  inventoryItemId String        @map("inventory_item_id")
  qty             Decimal       @db.Decimal(14, 3)
  unitCost        Decimal?      @map("unit_cost") @db.Decimal(14, 2)
  transfer        StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  item            InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("stock_transfer_items")
}

model Coupon {
  id                       String           @id @default(cuid())
  businessId               String           @map("business_id")
  couponCode               String           @map("coupon_code")
  couponName               String           @map("coupon_name")
  discountType             DiscountType     @map("discount_type")
  discountValue            Decimal          @map("discount_value") @db.Decimal(14, 2)
  maxDiscountAmount        Decimal?         @map("max_discount_amount") @db.Decimal(14, 2)
  minimumTransactionAmount Decimal          @default(0) @map("minimum_transaction_amount") @db.Decimal(14, 2)
  startDate                DateTime         @map("start_date")
  endDate                  DateTime         @map("end_date")
  usageLimit               Int?             @map("usage_limit")
  usagePerCustomer         Int?             @map("usage_per_customer")
  usedCount                Int              @default(0) @map("used_count")
  status                   Status           @default(ACTIVE)
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")
  categories               CouponCategory[]
  outlets                  CouponOutlet[]
  products                 CouponProduct[]
  usages                   CouponUsage[]
  business                 Business         @relation(fields: [businessId], references: [id])

  @@unique([businessId, couponCode])
  @@index([businessId])
  @@map("coupons")
}

model CouponOutlet {
  id       String @id @default(cuid())
  couponId String @map("coupon_id")
  outletId String @map("outlet_id")
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([couponId, outletId])
  @@map("coupon_outlets")
}

model CouponProduct {
  id        String  @id @default(cuid())
  couponId  String  @map("coupon_id")
  productId String  @map("product_id")
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
  @@map("coupon_products")
}

model CouponCategory {
  id       String @id @default(cuid())
  couponId String @map("coupon_id")
  category String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, category])
  @@map("coupon_categories")
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String   @map("coupon_id")
  saleId    String   @unique @map("sale_id")
  outletId  String   @map("outlet_id")
  cashierId String   @map("cashier_id")
  usedAt    DateTime @default(now()) @map("used_at")
  cashier   User     @relation(fields: [cashierId], references: [id])
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  sale      Sale     @relation(fields: [saleId], references: [id])

  @@map("coupon_usages")
}

enum Role {
  OWNER
  SUPERVISOR
  CASHIER
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum Status {
  ACTIVE
  INACTIVE
}

enum DiscountType {
  NOMINAL
  PERCENTAGE
}

enum PaymentMethod {
  CASH
  QRIS
  GOFOOD
  GRABFOOD
  SHOPEEFOOD
  VOUCHER
}

enum SaleStatus {
  DRAFT
  OPEN_ORDER
  ACCEPTED
  PENDING_PAYMENT
  PAID
  REJECTED
  CANCELLED
  COMPLETED
  VOID
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum PrinterType {
  THERMAL
}

enum ConnectionType {
  BLUETOOTH
  USB
  NETWORK
  BROWSER
}

enum PaperSize {
  MM58
  MM80
}

enum PrintType {
  CUSTOMER_ITEM_LIST
  CUSTOMER_RECEIPT
  KITCHEN_TICKET
  SHIFT_CLOSE_REPORT
}

enum PrintStatus {
  SUCCESS
  FAILED
}

enum PaymentSource {
  CASH_DRAWER
  NON_CASH
  OWNER_TRANSFER
}

enum ExpenseStatus {
  ACTIVE
  CANCELLED
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  ADJUSTMENT
  OPNAME
  SALE_DEDUCTION
  SALE_VOID_RETURN
  SALE_REFUND_RETURN
}

enum InventoryWarehouseType {
  CENTRAL
  PRODUCTION
  OUTLET
  VIRTUAL
}

enum StockTransferStatus {
  DRAFT
  SUBMITTED
  COMPLETED
  CANCELLED
}

enum InventoryStockAlertType {
  OUT_OF_STOCK
  LOW_STOCK
  CUSTOM_THRESHOLD
}

enum InventoryStockAlertState {
  NORMAL
  ALERTED
}

enum InventoryAlertLogStatus {
  SENT
  FAILED
}
